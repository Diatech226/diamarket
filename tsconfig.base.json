{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@diaexpress/shared": ["packages/diaexpress-shared/src/index.js"],
      "@diaexpress/shared/*": ["packages/diaexpress-shared/src/*"]
    }
  }
}
