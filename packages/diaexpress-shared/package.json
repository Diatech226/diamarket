{
  "name": "@diaexpress/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build.mjs --watch",
    "lint": "echo 'No lint configured for @diaexpress/shared'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abis/*": "./dist/abis/*",
    "./analytics/*": "./dist/analytics/*",
    "./api/*": "./dist/api/*",
    "./auth/*": "./dist/auth/*",
    "./components/*": "./dist/components/*",
    "./constants/*": "./dist/constants/*",
    "./context/*": "./dist/context/*",
    "./hooks/*": "./dist/hooks/*",
    "./marketing/*": "./dist/marketing/*",
    "./pages/*": "./dist/pages/*",
    "./styles/*": "./dist/styles/*",
    "./utils/*": "./dist/utils/*",
    "./views/*": "./dist/views/*"
  },
  "dependencies": {
    "react-hook-form": "^7.49.2",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@clerk/clerk-react": "^5.61.4",
    "@clerk/nextjs": "^6.39.1",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  },
  "peerDependenciesMeta": {
    "@clerk/clerk-react": {
      "optional": true
    },
    "@clerk/nextjs": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
