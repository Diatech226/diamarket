NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Canonical aliases used by CMS API helpers
NEXT_PUBLIC_DIAMARKET_API_URL=http://localhost:5001/api

# Runtime / routing
PORT=3001
NEXT_PUBLIC_DIAMARKET_WEB_URL=http://localhost:3000

# Auth/session behavior (cookie is set by API; frontend also stores Bearer token as needed)
NEXT_PUBLIC_AUTH_ME_PATH=/auth/me
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_LOGOUT_PATH=/auth/logout
NEXT_PUBLIC_REQUIRE_ADMIN_ROLE=true

# CORS/cookies expected from API
NEXT_PUBLIC_COOKIE_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_COOKIE_NAME=diamarket_session
