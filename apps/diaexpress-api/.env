

#################################
# Application
#################################

NODE_ENV=development
PORT=5010
TZ=UTC
REQUEST_LOGGING=false
ALLOW_DEGRADED_MODE=false
ENABLE_QUOTE_ESTIMATION_PROBE=false

#################################
# Database
#################################
MONGODB_URI=mongodb+srv://diaexpressofficial:Diaexpress1@cluster0.wxdxz04.mongodb.net/diaexpress?retryWrites=true&w=majority&appName=Cluster0
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/diaexpress
MONGODB_ALLOW_LOCAL_FALLBACK=false
MONGODB_CONNECTION_STRING=
MONGO_URI=mongodb+srv://diaexpressofficial:Diaexpress1@cluster0.wxdxz04.mongodb.net/diaexpress?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DNS_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_STARTUP_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
#################################
# URLs / CORS
#################################

API_PUBLIC_URL=
ENABLE_SWAGGER=true

CORS_ORIGINS=http://localhost:3010,http://localhost:3011

#################################
# Authentication / Clerk
#################################

DIAEXPRESS_AUTH_MODE=clerk
DIAEXPRESS_AUTH_SANDBOX=false
DIAEXPRESS_AUTH_SANDBOX_FIXTURE=
DIAEXPRESS_AUTH_CLIENTS=
DIAEXPRESS_AUTH_TOKENS=
DIAEXPRESS_AUTH_TOKEN_TTL=3600
CLERK_SECRET_KEY=
CLERK_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWT_AUDIENCES=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3011
CLERK_CLOCK_SKEW_MS=60000
DIAEXPRESS_CLERK_JWT_TEMPLATE=diaexpress-backend
CMS_CLERK_JWT_TEMPLATE=
CLERK_JWT_TEMPLATE=
CLERK_JWT_TEMPLATE_NAME=
CLERK_TEMPLATE=
CLERK_TOKEN_TEMPLATE=
CLERK_JWT_TEMPLATE_CANDIDATES=
DIAEXPRESS_CLERK_JWT_TEMPLATE_CANDIDATES=
DIAEXPRESS_CLERK_TEMPLATE=
DIAEXPRESS_ALLOW_LEGACY_CLERK_TEMPLATES=false

#################################
# Admin
#################################

ADMIN_DEFAULT_EMAIL=admin@diaexpress.local
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
ADMIN_NAME=DiaExpress Admin
ADMIN_DEFAULT_CLERK_ID=
ADMIN_WHITELIST=
ADMIN_SEED_EMAIL=admin@diaexpress.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=DiaExpress Admin
ADMIN_SEED_CLERK_ID=
ADMIN_SEED_EXTERNAL_ID=
CMS_ADMIN_EMAIL=admin@diaexpress.local
NEXT_PUBLIC_CMS_ADMIN_EMAIL=admin@diaexpress.local

#################################
# DiaPay
#################################

ENABLE_DIAPAY=false
NEXT_PUBLIC_ENABLE_DIAPAY=false
DIAPAY_API_URL=http://localhost:5100
DIAPAY_BASE_URL=http://localhost:5100
DIAPAY_API_KEY=
DIAPAY_BEARER_TOKEN=
DIAPAY_WEBHOOK_SECRET=
DIAPAY_API_TIMEOUT=15000
DIAPAY_TIMEOUT_MS=15000

#################################
# Email
#################################

EMAIL_USER=
EMAIL_PASS=

#################################
# Carriers - CMA CGM
#################################

CMACGM_MODE=sandbox
CMACGM_USE_SANDBOX=true
CMACGM_API_URL=https://sandbox.apis.cma-cgm.com
CMACGM_QUOTE_PATH=/v1/quotes
CMACGM_BOOKING_PATH=/v1/bookings
CMACGM_TRACKING_PATH=/v1/tracking
CMACGM_TIMEOUT_MS=10000
CMACGM_ACCOUNT_NUMBER=
CMACGM_API_KEY=
CMACGM_TOKEN_URL=
CMACGM_CLIENT_ID=
CMACGM_CLIENT_SECRET=
CMACGM_SCOPE=
CMACGM_SANDBOX_FIXTURE_PATH=
CMACGM_SANDBOX_QUOTE_FIXTURE_PATH=
CMACGM_SANDBOX_BOOKING_FIXTURE_PATH=
CMACGM_SANDBOX_TRACKING_FIXTURE_PATH=

#################################
# Carriers - FedEx
#################################

FEDEX_MODE=sandbox
FEDEX_USE_SANDBOX=true
FEDEX_API_URL=https://apis-sandbox.fedex.com
FEDEX_BOOKING_PATH=/ship/v1/shipments
FEDEX_TRACKING_PATH=/track/v1/trackingnumbers
FEDEX_TIMEOUT_MS=10000
FEDEX_TOKEN_URL=https://apis-sandbox.fedex.com/oauth/token
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SCOPE=oob
FEDEX_API_KEY=
FEDEX_SANDBOX_BOOKING_FIXTURE_PATH=
FEDEX_SANDBOX_TRACKING_FIXTURE_PATH=

#################################
# FX
#################################

FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=
FX_PROVIDER_TIMEOUT_MS=5000
FX_BASE_CURRENCY=XOF
FX_SUPPORTED_CURRENCIES=XOF,EUR,USD,CAD

#################################
# Integrations
#################################

INTEGRATION_API_KEYS=dev-diamarket-diaexpress-key
DIAMARKET_INTEGRATION_API_KEYS=dev-diamarket-diaexpress-key

#################################
# Compliance
#################################

AML_BLOCKLIST=
AML_HIGH_RISK_JURISDICTIONS=IR,CU,MM,SD,SY,UA
TRAVEL_RULE_THRESHOLD=1000

#################################
# Crypto Providers
#################################

FIREBLOCKS_API_BASE_URL=https://api.fireblocks.io
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=
FIREBLOCKS_VAULT_ACCOUNT_ID=
FIREBLOCKS_REQUIRED_CONFIRMATIONS=3
COINBASE_COMMERCE_API_BASE_URL=https://api.commerce.coinbase.com
COINBASE_COMMERCE_API_KEY=
COINBASE_REQUIRED_CONFIRMATIONS=2
