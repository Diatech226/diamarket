NODE_ENV=development
PORT=5010

# MongoDB Atlas - REQUIRED
# Copy exactly from MongoDB Atlas > Connect > Drivers
# Database path is required: /test or /diaexpress
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/diaexpress?retryWrites=true&w=majority&appName=Cluster0

# Local MongoDB fallback - OPTIONAL
# Must be mongodb://, never mongodb+srv://
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/diaexpress
MONGODB_ALLOW_LOCAL_FALLBACK=false

# Degraded mode - DISABLED BY DEFAULT
# Keep false. Only set true temporarily for UI troubleshooting.
ALLOW_DEGRADED_MODE=false

CORS_ORIGINS=http://localhost:3010,http://localhost:3011

# Production auth / admin bootstrap
DIAEXPRESS_AUTH_MODE=clerk
DIAEXPRESS_AUTH_SANDBOX=false
DIAEXPRESS_AUTH_CLIENTS=
DIAEXPRESS_AUTH_TOKENS=
DIAEXPRESS_AUTH_TOKEN_TTL=3600
JWT_SECRET=change-me-local-only
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWT_AUDIENCES=
CLERK_AUTHORIZED_PARTIES=
CLERK_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DIAEXPRESS_CLERK_JWT_TEMPLATE=diaexpress-backend
DIAEXPRESS_ALLOW_LEGACY_CLERK_TEMPLATES=false
ADMIN_WHITELIST=
ADMIN_DEFAULT_EMAIL=admin@diaexpress.local
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
ADMIN_DEFAULT_NAME=DiaExpress Admin
ADMIN_DEFAULT_CLERK_ID=
ADMIN_RESET_PASSWORD_ON_START=false
# Legacy aliases kept for older seed scripts.
ADMIN_SEED_EMAIL=admin@diaexpress.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=DiaExpress Admin
ADMIN_SEED_CLERK_ID=
CMS_ADMIN_EMAIL=admin@diaexpress.local

# DiaPay / payments
ENABLE_DIAPAY=false
DIAPAY_API_URL=
DIAPAY_BASE_URL=
DIAPAY_API_KEY=
DIAPAY_BEARER_TOKEN=
DIAPAY_WEBHOOK_SECRET=
DIAPAY_TIMEOUT_MS=15000

# Carriers / pricing / FX
CMACGM_MODE=sandbox
CMACGM_USE_SANDBOX=true
CMACGM_API_URL=
CMACGM_CLIENT_ID=
CMACGM_CLIENT_SECRET=
CMACGM_API_KEY=
FEDEX_MODE=sandbox
FEDEX_USE_SANDBOX=true
FEDEX_API_URL=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_API_KEY=
FX_BASE_CURRENCY=XOF
FX_SUPPORTED_CURRENCIES=XOF,EUR,USD,CAD
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=

# Runtime controls
REQUEST_LOGGING=false
INTEGRATION_API_KEYS=dev-diamarket-diaexpress-key
DIAMARKET_INTEGRATION_API_KEYS=dev-diamarket-diaexpress-key
MONGODB_CONNECTION_STRING=
MONGO_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
