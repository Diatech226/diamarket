NODE_ENV=development
PORT=5000

# MongoDB Atlas - REQUIRED
# Copy exactly from MongoDB Atlas > Connect > Drivers
# Database path is required: /test or /diaexpress
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/diaexpress?retryWrites=true&w=majority&appName=Cluster0

# Local MongoDB fallback - OPTIONAL
# Must be mongodb://, never mongodb+srv://
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/diaexpress
MONGODB_ALLOW_LOCAL_FALLBACK=false

# Degraded mode - DISABLED BY DEFAULT
# Keep false. Only set true temporarily for UI troubleshooting.
ALLOW_DEGRADED_MODE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
