NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/diamarket
JWT_SECRET=change-me-in-local-dev
ENABLE_EMAIL_PASSWORD_AUTH=true
PUBLIC_REGISTRATION_ENABLED=false
ADMIN_DEFAULT_EMAIL=admin@diamarket.local
ADMIN_DEFAULT_PASSWORD=change-me-admin-password
ADMIN_DEFAULT_NAME=Admin Diamarket
ADMIN_RESET_PASSWORD_ON_START=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
