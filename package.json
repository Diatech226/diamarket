{
  "name": "diamarket-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:diamarket": "turbo run dev --filter=diamarket-web --filter=diamarket-cms --filter=diamarket-api",
    "dev:diapay": "turbo run dev --filter=diapay-api --filter=diapay-dashboard --filter=diapay-docs --filter=diapay-sandbox",
    "dev:all": "turbo run dev",
    "build:diamarket": "turbo run build --filter=diamarket-web --filter=diamarket-cms --filter=diamarket-api",
    "build:diapay": "turbo run build --filter=diapay-api --filter=diapay-dashboard --filter=diapay-docs --filter=diapay-sandbox",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:mongo:dns": "npm --prefix apps/diamarket-api run test:mongo:dns"
  },
  "devDependencies": {
    "turbo": "^2.1.1",
    "typescript": "^5.5.2"
  }
}
