{
  "name": "diamarket-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:diamarket": "node scripts/dev.mjs diamarket",
    "dev:diapay": "node scripts/dev.mjs diapay",
    "dev:diaexpress": "node scripts/dev.mjs diaexpress",
    "dev:all": "node scripts/dev.mjs all",
    "build:diamarket": "turbo run build --filter=diamarket-web --filter=diamarket-cms --filter=diamarket-api",
    "build:diapay": "turbo run build --filter=diapay-api --filter=diapay-dashboard --filter=diapay-docs --filter=diapay-sandbox",
    "build:all": "turbo run build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:mongo:dns": "npm --prefix apps/diamarket-api run test:mongo:dns --",
    "build": "turbo build",
    "build:diaexpress": "turbo run build --filter=diaexpress-web --filter=diaexpress-admin --filter=diaexpress-api"
  },
  "devDependencies": {
    "turbo": "^2.1.1",
    "typescript": "^5.5.2"
  }
}
